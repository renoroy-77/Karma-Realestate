includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/

    level: 2

    ignoreErrors:
        - '#Access to an undefined property App\\Http\\Resources\\.*#'
        - '#Call to an undefined method App\\Http\\Resources\\.*#'
        - '#Cannot call method toISOString\(\) on string#'
        - '#Cannot call method format\(\) on string#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::.*#'
        - '#Call to an undefined static method Intervention\\Image\\Laravel\\Facades\\Image::.*#'

